{
  "name": "fjkm-ambatondrazaka-fitiavana",
  "version": "0.1.0",
  "description": "Logiciel de gestion de l’église FJKM Ambatondrazaka Fitiavana (desktop, offline)",
  "main": "./out/main/index.js",
  "author": "FJKM Ambatondrazaka Fitiavana",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "install-electron",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win --publish never",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux",
    "test": "cross-env ELECTRON_RUN_AS_NODE=1 electron ./node_modules/vitest/vitest.mjs run",
    "test:watch": "cross-env ELECTRON_RUN_AS_NODE=1 electron ./node_modules/vitest/vitest.mjs",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:reset": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/db-reset.ts",
    "db:reset:seed": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/db-reset.ts --seed",
    "fixture:snapshot": "cross-env ELECTRON_RUN_AS_NODE=1 FIXTURE_SNAPSHOT=1 electron ./node_modules/vitest/vitest.mjs run --project fixtures",
    "seed:accounting": "cross-env ELECTRON_RUN_AS_NODE=1 SEED_ACCOUNTING=1 electron ./node_modules/vitest/vitest.mjs run --project seed",
    "seed:members": "cross-env ELECTRON_RUN_AS_NODE=1 SEED_MEMBERS=1 electron ./node_modules/vitest/vitest.mjs run --project seed-members",
    "dev:seed": "cross-env APP_USER_DATA=.dev-data/seed electron-vite dev",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke"
  },
  "dependencies": {
    "better-sqlite3": "^13.2.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@hookform/resolvers": "^7.0.9",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.108.4",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.28",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.1.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-log": "^5.4.4",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jsdom": "^31.0.1",
    "lucide-react": "^1.79.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.92.0",
    "react-router": "^8.5.2",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.1.1",
    "zod": "^4.6.7"
  },
  "productName": "FJKM Ambatondrazaka Fitiavana"
}
